# MongoDB connection string. Must be a replica set (Atlas always is); debts use transactions.
MONGODB_URI=
# Two different random strings, at least 32 characters each (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Railway injects PORT automatically
PORT=3000
# Optional: comma separated list of allowed browser origins. Leave empty to disable CORS.
CORS_ORIGIN=
# Optional: comma separated emails allowed to register (case-insensitive). Empty = open registration.
# Recommended in production: set it to your own email(s).
ALLOWED_EMAILS=
