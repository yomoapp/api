{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix dashboard ci && npm --prefix dashboard run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "{src,public}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
